# The private computer of „Eigener Rechner (Sandbox)“ (#94): on Windows an own WSL2 distribution
# imported from this image's root file system. Docker runs only here; the workspace image is
# already in it, so no container ever needs a registry or the network.
FROM ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b

ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends docker.io iptables ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi; \
    mkdir -p /work /opt/aiscraft; \
    chmod 0711 /work

# No Windows drives, no Windows programs (the app writes this file again after the import).
COPY wsl.conf /etc/wsl.conf
COPY workspace-image.tar /opt/aiscraft/workspace-image.tar
COPY NOTICE.txt /opt/aiscraft/NOTICE.txt
