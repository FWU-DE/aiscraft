<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for AIS.ChatCraft. Pure Rust, no JIT, not sandboxed; learning
     apps run in aiscraft-preview's WKWebView, whose web content runs in WebKit's own processes.
     Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- Voice input: the hardened runtime blocks audio input (CoreAudio via cpal) without this,
       even after the user grants microphone access (NSMicrophoneUsageDescription). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
